diff --git a/packages/core/tests/unit/schema/block-select-presentation.test.ts b/packages/core/tests/unit/schema/block-select-presentation.test.ts
new file mode 100644
index 0000000..55164ef
--- /dev/null
+++ b/packages/core/tests/unit/schema/block-select-presentation.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from "vitest";
+
+import { blockFieldDefinitionSchema } from "../../../src/api/schemas/schema.js";
+import {
+	compareBlockFields,
+	validateBlockFields,
+} from "../../../src/schema/block-type-contract.js";
+import type { BlockFieldDefinition } from "../../../src/schema/block-types.js";
+import { generateBlockFieldSchema } from "../../../src/schema/zod-generator.js";
+
+const field: BlockFieldDefinition = {
+	slug: "questions",
+	label: "Questions",
+	type: "repeater",
+	validation: {
+		subFields: [
+			{
+				slug: "faq",
+				label: "FAQ",
+				type: "select",
+				required: true,
+				options: ["faq-1", "faq-2"],
+				optionLabels: { "faq-1": "How does delivery work?", "faq-2": "How does delivery work?" },
+				searchable: true,
+			},
+		],
+	},
+};
+describe("block select presentation", () => {
+	it("retains labels/search in REST but validates only the stable stored values", () => {
+		expect(blockFieldDefinitionSchema.parse(field)).toEqual(field);
+		expect(validateBlockFields([field])).toEqual([field]);
+		const schema = generateBlockFieldSchema(field);
+		expect(schema.parse([{ faq: "faq-2" }])).toEqual([{ faq: "faq-2" }]);
+		expect(schema.safeParse([{ faq: "How does delivery work?" }]).success).toBe(false);
+	});
+	it("rejects ghost labels, empty labels and presentation on non-select fields", () => {
+		for (const extra of [
+			{ optionLabels: { ghost: "Question" } },
+			{ optionLabels: { "faq-1": "" } },
+			{ searchable: "yes" },
+		]) {
+			const next = structuredClone(field);
+			Object.assign(next.validation!.subFields![0]!, extra);
+			expect(() => validateBlockFields([next])).toThrow();
+		}
+		expect(() =>
+			validateBlockFields([
+				{ slug: "name", label: "Name", type: "string", validation: { searchable: true } },
+			]),
+		).toThrow();
+	});
+	it("keeps label and search changes compatible without weakening value constraints", () => {
+		const next = structuredClone(field);
+		next.validation!.subFields![0]!.optionLabels = {
+			"faq-1": "Updated title",
+			"faq-2": "Another question",
+		};
+		next.validation!.subFields![0]!.searchable = false;
+		expect(compareBlockFields([field], [next]).compatible).toBe(true);
+		next.validation!.subFields![0]!.options = ["faq-1"];
+		expect(compareBlockFields([field], [next]).compatible).toBe(false);
+	});
+	it("preserves ordinary string option definitions", () => {
+		const plain: BlockFieldDefinition = {
+			slug: "kind",
+			label: "Kind",
+			type: "select",
+			validation: { options: ["one", "two"] },
+		};
+		expect(validateBlockFields([plain])).toEqual([plain]);
+		expect(generateBlockFieldSchema(plain).parse("one")).toBe("one");
+	});
+});
